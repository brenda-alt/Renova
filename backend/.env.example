# Copie este arquivo para .env e substitua os marcadores.
# USUARIO e SENHA não são credenciais reais.
# O backend usa o PostgreSQL na porta 5433, banco renova.
# Origens do front-end local. Separe por vírgula se precisar incluir outra.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# O MySQL original permanece intacto como cópia de recuperação e não é lido pela API.
# Caracteres especiais na senha precisam ser codificados na URL.
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5433/renova"
SHADOW_DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5433/renova_shadow"

# Chave usada para assinar e validar o JWT. Mínimo de 32 caracteres.
# Gere um valor aleatório no ambiente. Não reuse um exemplo e não grave a chave no código.
JWT_SECRET=

# O script npm run seed:primeiro-usuario só cria o primeiro usuário se estas
# variáveis estiverem preenchidas no ambiente. Não as versione com valores reais.
# SEED_USUARIO_NOME=
# SEED_USUARIO_EMAIL=
# SEED_USUARIO_SENHA=
# SEED_USUARIO_PERFIL=
